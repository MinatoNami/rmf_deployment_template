# Copy to .env in this directory, then fill in the two credentials.
# docker compose reads .env automatically.

# --- Required: LionsBot cloud credentials (api.lionsbot.io) ---
LIONSBOT_USER=replace-me
LIONSBOT_PASSWORD=replace-me

# --- Site selection (must match directories in the adapter repo) ---
FOLDER_NAME=office_new
FLOOR_NAME=L8
FLEET_1_CONFIG=config_r5.yaml
FLEET_1_NAV_GRAPH=0.yaml
FLEET_2_CONFIG=config_r3scp.yaml
FLEET_2_NAV_GRAPH=1.yaml

# Path to the fleet_adapter_lionsbot ROS package (the directory holding
# package.xml), relative to this file or absolute.
LIONSBOT_ADAPTER_PATH=../../../fleet_adapter_lionsbot/fleet_adapter

# --- Lift (only used by `docker compose --profile lift`) ---
# Path to the lift_adapter_template ROS package (the directory holding
# package.xml), relative to this file or absolute. It must be a checkout of the
# feat/mock-lift branch of github.com/MinatoNami/lift_adapter_template; upstream
# has no simulated lift and exits at startup.
LIFT_ADAPTER_PATH=../../../lift_adapter_template/lift_adapter_template
# LIFT_1_NAME must match the key under `lifts:` in the building map and the
# nav graph, and the `lift:` property on the cabin waypoints.
LIFT_1_NAME=lift_1
LIFT_1_CONFIG=mock_lift.yaml
# Force the simulated lift even if the config says otherwise. The shipped
# mock_lift.yaml already sets mock.enabled, so this can stay false.
LIFT_1_MOCK=false

# --- ROS ---
ROS_DOMAIN_ID=0
RMW_IMPLEMENTATION=rmw_cyclonedds_cpp
USE_SIM_TIME=false

# --- rmf-web ---
DASHBOARD_PORT=3001  # 3000 was taken on this machine
SERVER_URI=ws://localhost:8000/_internal
RMF_SERVER_URL=http://localhost:8000
TRAJECTORY_SERVER_URL=ws://localhost:8006
RMF_WEB_ALERTS_URL=http://localhost:8000/alerts/request
# Leave blank: the adapter entrypoint mints a token matching the api-server's
# default stub secret. Set it only if you changed the api-server config.
RMF_WEB_API_TOKEN=
